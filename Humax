<script>

let totalStake = 0;
let totalRewards = 0;
let referrals = 12;

document.getElementById("refCount").innerText = referrals;

function updateUI(){

document.getElementById("stakeBalance").innerText =
totalStake.toFixed(2) + " HMX";

document.getElementById("rewardBalance").innerText =
totalRewards.toFixed(2) + " HMX";

document.getElementById("dailyEarn").innerText =
(totalStake * 0.0015).toFixed(2);

}

function stake(days,apy){

let input = document.getElementById("stake"+days);

let amount = parseFloat(input.value);

if(!amount || amount <= 0){

alert("Enter valid amount");
return;

}

totalStake += amount;

let reward = amount * (apy / 100);

totalRewards += reward;

updateUI();

alert(
"Successfully staked " +
amount +
" HMX in " +
days +
" days pool."
);

input.value = "";

}

function claimRewards(){

if(totalRewards <= 0){

alert("No rewards available.");
return;

}

alert(
"Successfully claimed " +
totalRewards.toFixed(2) +
" HMX rewards!"
);

totalRewards = 0;

updateUI();

}

function copyRef(){

let text = document.getElementById("refLink").innerText;

navigator.clipboard.writeText(text);

alert("Referral link copied!");

}

updateUI();

</script>

